# Copy this file to .env.local and add your real keys there (.env.local is gitignored).
# OpenAI: https://platform.openai.com/api-keys
# OpenRouter: https://openrouter.ai/keys
OPENAI_API_KEY=
# Optional for OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=https://your-app.up.railway.app
# (On Vercel use https://YOUR-APP.vercel.app — analysis completes inside POST /api/jobs)
# Optional: max parallel LLM calls (default 2)
# LLM_CONCURRENCY=2
# Empty-frame skip (default on). Set to false to always call LLM.
# SKIP_EMPTY_FRAMES=true
# EMPTY_STDEV_THRESHOLD=12
# Burst dedup within N ms (default 2000). Set DEDUPE_BURST=false to analyze every file.
# When frames in a burst disagree, a clear species (e.g. Elephant) is copied to nearby Unidentified frames.
# BURST_GAP_MS=2000
# Optional: save each analysis run to Supabase (no app login — server-only).
# Create a project at https://supabase.com, run supabase/schema.sql in SQL Editor.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co   (Settings → General → Project URL)
# SUPABASE_SERVICE_ROLE_KEY=...   (Settings → API Keys → Secret key sb_secret_... OR Legacy → service_role)
