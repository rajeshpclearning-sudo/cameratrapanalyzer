# Copy this file to .env.local and add your real keys there (.env.local is gitignored).
# OpenAI: https://platform.openai.com/api-keys
# OpenRouter: https://openrouter.ai/keys
OPENAI_API_KEY=
# Optional for OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=https://your-app.up.railway.app
# Optional: max parallel LLM calls (default 2)
# LLM_CONCURRENCY=2
# Empty-frame skip (default on). Set to false to always call LLM.
# SKIP_EMPTY_FRAMES=true
# EMPTY_STDEV_THRESHOLD=12
# Burst dedup within N ms (default 2000). Set DEDUPE_BURST=false to analyze every file.
# When frames in a burst disagree, a clear species (e.g. Elephant) is copied to nearby Unidentified frames.
# BURST_GAP_MS=2000
