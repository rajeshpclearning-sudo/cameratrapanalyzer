{
  "name": "camera-trap-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build && node scripts/copy-standalone.mjs && node scripts/verify-css.mjs",
    "start": "HOSTNAME=0.0.0.0 next start -p ${PORT:-3000}",
